diff --git a/src/ca_main.c b/src/ca_main.c
index 49d3af6..88e2c42 100644
--- a/src/ca_main.c
+++ b/src/ca_main.c
@@ -52,6 +52,91 @@ print_usage(
     fprintf(stderr, "\t-h Show this help.\n");
 }
 
+#ifdef GPU_OMP
+static int
+read_env_int(
+    const char *name,
+    int *value)
+{
+    char *end = NULL;
+    const char *raw = getenv(name);
+    long parsed;
+
+    if (raw == NULL || raw[0] == '\0')
+        return 0;
+
+    parsed = strtol(raw, &end, 10);
+    if (end == raw || *end != '\0')
+        return 0;
+
+    *value = (int) parsed;
+    return 1;
+}
+
+static int
+local_rank_from_env(
+    int *local_rank)
+{
+    static const char *local_rank_envs[] = {
+        "SLURM_LOCALID",
+        "OMPI_COMM_WORLD_LOCAL_RANK",
+        "MV2_COMM_WORLD_LOCAL_RANK",
+        "MPI_LOCALRANKID",
+        "PMI_LOCAL_RANK"
+    };
+
+    for (size_t i = 0;
+         i < sizeof(local_rank_envs) / sizeof(local_rank_envs[0]); i++)
+    {
+        if (read_env_int(local_rank_envs[i], local_rank))
+            return 1;
+    }
+
+    return 0;
+}
+
+static void
+select_openmp_device_for_rank(
+    void)
+{
+    int requested_device = -1;
+    int local_rank = 0;
+    int num_devices = omp_get_num_devices();
+
+    if (num_devices <= 0)
+    {
+        if (iproc == 0)
+            fprintf(stderr,
+                    "GPU_OMP build found no OpenMP target devices.\n");
+        return;
+    }
+
+    if (read_env_int("MUMATSCALE_OMP_DEVICE", &requested_device))
+    {
+        if (requested_device < 0 || requested_device >= num_devices)
+        {
+            fprintf(stderr,
+                    "Rank %d requested OpenMP device %d, but %d devices are visible.\n",
+                    iproc, requested_device, num_devices);
+            MPI_Abort(MPI_COMM_WORLD, 1);
+        }
+    }
+    else if (getenv("OMP_DEFAULT_DEVICE") == NULL &&
+             local_rank_from_env(&local_rank))
+    {
+        requested_device = local_rank % num_devices;
+    }
+
+    if (requested_device >= 0)
+    {
+        omp_set_default_device(requested_device);
+        if (nproc <= 20)
+            printf("MPI rank %d using OpenMP device %d of %d visible devices\n",
+                   iproc, requested_device, num_devices);
+    }
+}
+#endif
+
 void
 signal_handler(
     int signum)
@@ -142,6 +227,10 @@ main(
     MPI_Comm_size(MPI_COMM_WORLD, &nproc);
     MPI_Comm_rank(MPI_COMM_WORLD, &iproc);
 
+#ifdef GPU_OMP
+    select_openmp_device_for_rank();
+#endif
+
     if (iproc == 0)
         printf("Start the program... \n");
 
