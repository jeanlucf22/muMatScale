+{
+    int complete = 0;
+    int err;
+    variable_registration *v = &var_regs[variable_key];
+
+    err = MPI_Testall(v->nreq, v->reqs, &complete, MPI_STATUSES_IGNORE);
+    if (err != MPI_SUCCESS)
+        error("MPI_Testall failed for halo variable %d: %d\n",
+              variable_key, err);
+
+    return complete;
+}
